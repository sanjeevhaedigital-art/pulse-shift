# Copy to .env and change the values
PORT=3000

# Your Pulse Shift Media account. Created on first start (also the platform admin who manages all companies)
OWNER_COMPANY=Pulse Shift Media
OWNER_NAME=Navjot Kaur
OWNER_EMAIL=owner@pulseshiftmedia.com
OWNER_PASSWORD=ChangeMe@123

# Extra platform admins (comma-separated emails)
PLATFORM_ADMIN_EMAILS=

# Long random string that signs login sessions. If empty, one is generated in data/.jwt-secret
JWT_SECRET=

# true when served over HTTPS (production)
COOKIE_SECURE=false

# Demo data and demo login cards. Set both to false for a clean production install
SEED_DEMO=true
SHOW_DEMO_LOGINS=true

# SQLite file (default: ./data/pulse-shift-lms.db). On Render/Railway point this at the persistent disk
# DB_FILE=/var/data/pulse-shift-lms.db

TZ=Asia/Dubai

# Razorpay (Dashboard > Settings > API Keys, and Subscriptions > Plans). Leave empty to switch online billing off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_BUSINESS=
